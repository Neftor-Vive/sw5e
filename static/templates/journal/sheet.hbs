<form class="{{cssClass}} sw5e-app-shell sw5e-form-shell" autocomplete="off">
  <div class="sw5e-section">
    <input name="name" type="text" value="{{entity.name}}" placeholder="Entry Title" />

    <select name="folder">
      {{selectOptions folders selected=entity.folder blank="" labelAttr="name" valueAttr="id"}}
    </select>
  </div>

  <div class="sw5e-section">
    {{editor contentHTML target="content" button=true editable=editable owner=owner}}
  </div>
  {{#if editable}}
    <div class="form-actions">
      <button type="submit" name="submit"><i class="fas fa-feather-alt"></i> Save Entry</button>
    </div>
  {{/if}}
</form>
