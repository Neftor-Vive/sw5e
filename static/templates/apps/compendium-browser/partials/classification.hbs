<li class="item flexrow browser-result-row" data-entry-uuid="{{entry.uuid}}" data-type="Item" tabindex="0" role="button" aria-label="Open {{entry.name}}">
    <div class="image">
        <img class="" src="{{entry.img}}" title="{{entry.name}}" width="32" height="32" loading="lazy"/>
    </div>
    <div class="name">
        <a class="item-link">{{entry.name}}</a>
    </div>
</li>
