<div class="compendium-browser-settings sw5e-app-shell sw5e-form-shell">
    <form autocomplete="off">
        <div class="settings-container">
            {{#each settingsTabData.groups as |group|}}
                <div class="setting-section">
                    <h3>{{localize group.label}}</h3>
                    <dl>
                        {{#each group.packs as |pack|}}
                            <label>
                                <dt><input type="checkbox" name="{{group.id}}-{{pack.collection}}" {{checked pack.load}}></dt>
                                <dd>{{pack.name}}</dd>
                            </label>
                        {{/each}}
                    </dl>
                </div>
            {{/each}}
        </div>

        <div class="form-actions">
            <button type="button" class="save-settings" data-action="save-settings">{{localize "SETTINGS.Save"}}</button>
        </div>
    </form>
</div>
